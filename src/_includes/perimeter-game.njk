{# PERIMETER minigame. Set pm_mode = "page" or "embedded" before including. #}
<div id="pm-root" class="pm-root" data-pm-mode="{{ pm_mode }}"{% if pm_mode == "embedded" %} hidden{% endif %}>
    <!-- Enemy shapes, shared by the legend and the ammo slots -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <defs>
            <symbol id="pm-shape-0" viewBox="-12 -12 24 24"><polygon points="0,-10 8.7,5 -8.7,5" /></symbol>
            <symbol id="pm-shape-1" viewBox="-12 -12 24 24"><rect x="-7.5" y="-7.5" width="15" height="15" /></symbol>
            <symbol id="pm-shape-2" viewBox="-12 -12 24 24"><polygon points="0,-10 8,0 0,10 -8,0" /></symbol>
            <symbol id="pm-shape-3" viewBox="-12 -12 24 24"><polygon points="9,0 4.5,7.8 -4.5,7.8 -9,0 -4.5,-7.8 4.5,-7.8" /></symbol>
        </defs>
    </svg>

    <canvas id="pm-canvas" aria-label="PERIMETER battlefield"></canvas>

    <!-- In-game HUD -->
    <div class="pm-hud" id="pm-hud" hidden>
        <div class="pm-stats">
            <div class="pm-stat"><span class="pm-label">WAVE</span><span class="pm-value" id="pm-wave">01</span></div>
            <div class="pm-stat"><span class="pm-label">SCORE</span><span class="pm-value" id="pm-score">000000</span></div>
            <div class="pm-stat"><span class="pm-label">BEST</span><span class="pm-value" id="pm-best">000000</span></div>
        </div>
        <div class="pm-console">
            <div class="pm-integrity">
                <span class="pm-label">CORE INTEGRITY</span>
                <div class="pm-integrity-bars" id="pm-integrity">
                    <span></span><span></span><span></span><span></span><span></span>
                </div>
            </div>
            <div class="pm-slots">
                <button type="button" class="pm-slot" data-ammo="0" style="--ammo:#ff3b5c"><svg><use href="#pm-shape-0"/></svg><kbd>A</kbd></button>
                <button type="button" class="pm-slot" data-ammo="1" style="--ammo:#ffc400"><svg><use href="#pm-shape-1"/></svg><kbd>S</kbd></button>
                <button type="button" class="pm-slot" data-ammo="2" style="--ammo:#3dff8a"><svg><use href="#pm-shape-2"/></svg><kbd>D</kbd></button>
                <button type="button" class="pm-slot" data-ammo="3" style="--ammo:#8f7bff"><svg><use href="#pm-shape-3"/></svg><kbd>F</kbd></button>
            </div>
        </div>
    </div>

    <div class="pm-banner" id="pm-banner" aria-live="polite">
        <div class="pm-banner-title" id="pm-banner-title"></div>
        <div class="pm-banner-sub" id="pm-banner-sub"></div>
    </div>

    <!-- Start screen -->
    <section class="pm-panel" id="pm-start" hidden>
        <h1 class="pm-title">PERIMETER</h1>
        <div class="header-line"></div>
        <p>Hostiles are advancing on the core. Each kind only goes down to its matching ammo, so swap fast.</p>
        <ul class="pm-legend">
            <li style="--ammo:#ff3b5c"><svg><use href="#pm-shape-0"/></svg><kbd>A</kbd><span>SPIKE</span><small>RUSHER</small></li>
            <li style="--ammo:#ffc400"><svg><use href="#pm-shape-1"/></svg><kbd>S</kbd><span>BLOCK</span><small>ARMORED</small></li>
            <li style="--ammo:#3dff8a"><svg><use href="#pm-shape-2"/></svg><kbd>D</kbd><span>SHARD</span><small>EVASIVE</small></li>
            <li style="--ammo:#8f7bff"><svg><use href="#pm-shape-3"/></svg><kbd>F</kbd><span>HIVE</span><small>SPLITTER</small></li>
        </ul>
        <p class="pm-controls">AIM: MOUSE &nbsp;//&nbsp; FIRE: CLICK &nbsp;//&nbsp; AMMO: A S D F &nbsp;//&nbsp; PAUSE: ESC</p>
        <div class="pm-actions">
            <button type="button" class="pm-btn" id="pm-start-btn">ENGAGE</button>
            <a href="/projects/" class="pm-btn pm-exit">EXIT</a>
        </div>
        <p class="pm-needs" id="pm-needs" hidden>PERIMETER needs a mouse and keyboard. Come back on a computer!</p>
    </section>

    <!-- Pause -->
    <section class="pm-panel pm-panel-small" id="pm-pause" hidden>
        <h2 class="pm-title">PAUSED</h2>
        <div class="header-line"></div>
        <div class="pm-actions">
            <button type="button" class="pm-btn" id="pm-resume-btn">RESUME</button>
            <button type="button" class="pm-btn" id="pm-restart-btn">RESTART</button>
            <a href="/projects/" class="pm-btn pm-exit">EXIT</a>
        </div>
    </section>

    <!-- Game over -->
    <section class="pm-panel pm-panel-small" id="pm-over" hidden>
        <h2 class="pm-title pm-title-alert">CORE BREACHED</h2>
        <div class="header-line"></div>
        <dl class="pm-results">
            <dt>WAVE REACHED</dt><dd id="pm-final-wave">01</dd>
            <dt>SCORE</dt><dd id="pm-final-score">000000</dd>
            <dt>BEST</dt><dd id="pm-final-best">000000</dd>
        </dl>
        <p class="pm-new-best" id="pm-new-best" hidden>// NEW BEST //</p>
        <div class="pm-actions">
            <button type="button" class="pm-btn" id="pm-retry-btn">RETRY</button>
            <a href="/projects/" class="pm-btn pm-exit">EXIT</a>
        </div>
    </section>
</div>
