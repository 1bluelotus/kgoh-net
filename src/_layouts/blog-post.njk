---
layout: shell.njk
parentSection: blog
---
<article class="page-article">
    <a href="/blog/" class="cs-back-link">[ &larr; BLOG ]</a>
    <div class="section-header page-header">
        <h1>{{ title }}</h1>
        <div class="header-line"></div>
    </div>
    <div class="blog-post-meta">
        <span>{{ date | blogDate }}</span>
        <span class="meta-divider">//</span>
        <span>WRITTEN BY KEVEN GOH</span>
        {% if extra_meta %}<span class="meta-divider">//</span>
        <span>{{ extra_meta }}</span>{% endif %}
    </div>
    <div class="cs-body">
        {{ content | safe }}
    </div>
</article>
