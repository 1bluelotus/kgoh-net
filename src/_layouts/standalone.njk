---
layout: shell.njk
parentSection: home
---
<article class="page-article">
    <a href="/" class="cs-back-link">[ &larr; {{ back_label | default("HOME") }} ]</a>
    <div class="section-header">
        <h1>{{ title }}<span class="header-colon">:</span></h1>
        <div class="header-line"></div>
    </div>
    <p class="cs-subtitle">{{ subtitle | safe }}</p>
    <div class="cs-body">
        {{ content | safe }}
    </div>
</article>
