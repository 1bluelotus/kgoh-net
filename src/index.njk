<body>
    <!-- Mobile warning overlay -->
    <div id="mobile-overlay">
        <div class="mob-corner mob-tl"></div>
        <div class="mob-corner mob-tr"></div>
        <div class="mob-corner mob-bl"></div>
        <div class="mob-corner mob-br"></div>
        <div class="mob-panel">
            <div class="mob-header">// DISPLAY WARNING</div>
            <div class="mob-body">
                <p>I designed this website to be optimized for a desktop viewing experience.</p>
                <p>Please visit on a larger screen while I work on the mobile version!</p>
                <span class="mob-sig">— Keven</span>
            </div>
        </div>
    </div>

    <!-- HUD Corner Decorations -->
        <div class="corner-decoration top-left"></div>
        <div class="corner-decoration top-right"></div>
        <div class="corner-decoration bottom-left"></div>
        <div class="corner-decoration bottom-right"></div>

        <!-- Minimap and Navigation -->
        <div class="hud-nav">
            <div class="minimap-container">
                <svg class="minimap" viewBox="0 0 200 200">
                    <!-- Map background grid (three theme variants) -->
                    <defs>
                        <pattern id="grid-standard" width="20" height="20" patternUnits="userSpaceOnUse">
                            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="0.7"/>
                        </pattern>
                        <pattern id="grid-retro" width="20" height="20" patternUnits="userSpaceOnUse">
                            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(51,255,51,0.2)" stroke-width="0.5"/>
                        </pattern>
                        <pattern id="grid-neon" width="20" height="20" patternUnits="userSpaceOnUse">
                            <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(0,245,255,0.25)" stroke-width="0.5"/>
                        </pattern>
                        <filter id="dot-glow" x="-150%" y="-150%" width="400%" height="400%">
                            <feGaussianBlur stdDeviation="2.5" result="blur"/>
                            <feMerge>
                                <feMergeNode in="blur"/>
                                <feMergeNode in="SourceGraphic"/>
                            </feMerge>
                        </filter>
                    </defs>
                    <rect id="minimap-flash-bg" width="200" height="200" fill="#00ff41" opacity="0" style="transition: opacity 0.3s ease;"/>
                    <rect id="minimap-grid-bg" width="200" height="200" fill="url(#grid-standard)"/>
                    
                    <!-- Map border -->
                    <rect id="minimap-border" x="1" y="1" width="198" height="198" fill="none" stroke="white" stroke-width="2"/>
                    
                    <!-- Navigation trail (drawn behind waypoints) -->
                    <g id="nav-trail"></g>

                    <!-- Waypoints: home(50,50) about(150,50) studies(100,80) blog(50,120) photos(150,120) resume(100,155) -->
                    <circle class="waypoint" data-section="home" cx="50" cy="50" r="4" fill="white"/>
                    <g class="waypoint-lock" data-section="home">
                        <line x1="42" y1="42" x2="42" y2="47" stroke="#ff0000" stroke-width="1.5"/>
                        <line x1="42" y1="42" x2="47" y2="42" stroke="#ff0000" stroke-width="1.5"/>
                        <line x1="58" y1="42" x2="58" y2="47" stroke="#ff0000" stroke-width="1.5"/>
                        <line x1="53" y1="42" x2="58" y2="42" stroke="#ff0000" stroke-width="1.5"/>
